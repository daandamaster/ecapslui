<!-- Lightweight JS handler to demonstrate realistic toggle between OK, Melding, and unselected -->
<script data-purpose="toggle-inspection-status">
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('[data-purpose="inspection-item"]');

      cards.forEach(card => {
        const okBtn = card.querySelector('button:nth-child(1)');
        const meldingBtn = card.querySelector('button:nth-child(2)');
        const statusDot = card.querySelector('span[aria-label]');

        if (!okBtn || !meldingBtn) return;

        okBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const isSelected = okBtn.classList.contains('border-emerald-600');
          if (isSelected) {
            // Deselect
            okBtn.className = "px-3.5 py-1.5 min-w-[54px] rounded-lg border border-slate-200 text-slate-700 bg-white font-medium text-xs hover:bg-slate-50 tap-active";
            statusDot.className = "w-2.5 h-2.5 rounded-full bg-slate-300 mt-1 shrink-0";
          } else {
            // Select OK
            okBtn.className = "px-3.5 py-1.5 min-w-[54px] rounded-lg border-2 border-emerald-600 text-emerald-700 bg-emerald-50/60 font-semibold text-xs tap-active";
            meldingBtn.className = "px-3 py-1.5 min-w-[62px] rounded-lg border border-slate-200 text-slate-700 bg-white font-medium text-xs hover:bg-slate-50 tap-active";
            statusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 mt-1 shrink-0";
          }
        });

        meldingBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const isSelected = meldingBtn.classList.contains('border-amber-600');
          if (isSelected) {
            // Deselect
            meldingBtn.className = "px-3 py-1.5 min-w-[62px] rounded-lg border border-slate-200 text-slate-700 bg-white font-medium text-xs hover:bg-slate-50 tap-active";
            statusDot.className = "w-2.5 h-2.5 rounded-full bg-slate-300 mt-1 shrink-0";
          } else {
            // Select Melding
            meldingBtn.className = "px-3 py-1.5 min-w-[62px] rounded-lg border-2 border-amber-600 text-amber-700 bg-amber-50/70 font-semibold text-xs tap-active";
            okBtn.className = "px-3.5 py-1.5 min-w-[54px] rounded-lg border border-slate-200 text-slate-700 bg-white font-medium text-xs hover:bg-slate-50 tap-active";
            statusDot.className = "w-2.5 h-2.5 rounded-full bg-amber-500 mt-1 shrink-0";
          }
        });
      });
    });
  </script>
